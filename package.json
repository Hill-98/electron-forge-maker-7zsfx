{
  "name": "electron-forge-maker-7zsfx",
  "version": "1.2.5",
  "description": "7zsfx maker for Electron Forge",
  "keywords": [
    "electron",
    "forge",
    "maker",
    "7z",
    "sfx",
    "windows"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Hill-98/electron-forge-maker-7zsfx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hill-98/electron-forge-maker-7zsfx.git"
  },
  "bugs": "https://github.com/Hill-98/electron-forge-maker-7zsfx/issues",
  "author": "Zhong Lufan <lufanzhong@gmail.com>",
  "files": [
    "./bin",
    "./dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.cjs"
  },
  "scripts": {
    "prepublishOnly": "npm run check && npm run test && npm run build",
    "build": "tsdown",
    "check": "biome check && tsc --noEmit",
    "test": "node --experimental-test-coverage --test",
    "prepare": "husky"
  },
  "engines": {
    "node": ">= 16.4.0"
  },
  "dependencies": {
    "@electron-forge/maker-base": "^7.0.0",
    "@electron-forge/shared-types": "^7.0.0",
    "@electron/windows-sign": "^2.0.2",
    "rcedit": "^5.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "latest",
    "husky": "^9.1.6",
    "tsdown": "^0.22.14",
    "typescript": "~7.0.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts"
}
